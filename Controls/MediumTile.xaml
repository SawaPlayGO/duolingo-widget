<UserControl
    x:Class="DuolingoWidget.Controls.MediumTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DuolingoWidget.Controls"
    Width="150"
    Height="150">
    <Grid>
        <Image Source="{x:Bind Theme.MediumBackgroundImage, Mode=OneWay}" Stretch="Fill"/>
        <Image Source="{x:Bind Theme.MediumDuoImage, Mode=OneWay}"
               Width="150" Height="84" VerticalAlignment="Bottom" Stretch="Fill"/>
        <Grid Width="150" Height="66" HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <Image x:Name="FireImage" Width="48" Height="48" Stretch="Fill"/>
                <controls:DigitText Streak="{x:Bind Streak, Mode=OneWay}"
                                    Width="61" Height="25"
                                    OutlineWidth="69" OutlineHeight="33"
                                    MaxTextWidth="61" BaseFontSize="36"
                                    DigitBrush="{x:Bind Theme.DigitBrush, Mode=OneWay}"
                                    OutlineBrush="{x:Bind Theme.DigitOutlineBrush, Mode=OneWay}"
                                    OutlineVisibility="{x:Bind Theme.DigitOutlineVisibility, Mode=OneWay}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
