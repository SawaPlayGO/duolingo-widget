<UserControl
    x:Class="DuolingoWidget.Controls.SmallDigitalTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DuolingoWidget.Controls"
    Width="71"
    Height="71">
    <Grid>
        <Image Source="{x:Bind Theme.SmallBackgroundImage, Mode=OneWay}" Stretch="Fill"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
            <Image x:Name="FireImage" Width="32" Height="32" Stretch="Fill"/>
            <controls:DigitText Streak="{x:Bind Streak, Mode=OneWay}"
                                Width="61" Height="25"
                                OutlineWidth="69" OutlineHeight="33"
                                MaxTextWidth="61" BaseFontSize="36"
                                DigitBrush="{x:Bind Theme.DigitBrush, Mode=OneWay}"
                                OutlineBrush="{x:Bind Theme.DigitOutlineBrush, Mode=OneWay}"
                                OutlineVisibility="{x:Bind Theme.DigitOutlineVisibility, Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</UserControl>
