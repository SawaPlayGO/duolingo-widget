<UserControl
    x:Class="DuolingoWidget.Controls.LargeTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DuolingoWidget.Controls"
    Width="310"
    Height="310">
    <Grid>
        <Image Source="{x:Bind Theme.LargeBackgroundImage, Mode=OneWay}" Stretch="Fill"/>
        <Image Source="{x:Bind Theme.LargeDuoImage, Mode=OneWay}"
               Width="310" Height="173" VerticalAlignment="Bottom" Stretch="Fill"/>
        <StackPanel Width="231" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="{x:Bind Theme.LargeContentMargin, Mode=OneWay}" Spacing="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <Image x:Name="FireImage" Width="64" Height="64" Stretch="Fill"/>
                <controls:DigitText Streak="{x:Bind Streak, Mode=OneWay}"
                                    Width="107" Height="44"
                                    OutlineWidth="115" OutlineHeight="52"
                                    MaxTextWidth="107" BaseFontSize="64"
                                    DigitBrush="{x:Bind Theme.DigitBrush, Mode=OneWay}"
                                    OutlineBrush="{x:Bind Theme.DigitOutlineBrush, Mode=OneWay}"
                                    OutlineVisibility="{x:Bind Theme.DigitOutlineVisibility, Mode=OneWay}"/>
            </StackPanel>
            <TextBlock Text="Time to practice!" Visibility="{x:Bind Theme.PhraseVisibility, Mode=OneWay}"
                       FontFamily="ms-appx:///Assets/Fonts/DIN_Next_Rounded_LT_Pro.ttc#DIN Next Rounded LT Pro"
                       FontSize="32" LineHeight="32" TextLineBounds="TrimToCapHeight" FontWeight="Normal"
                       Width="231" Height="32" HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="{x:Bind Theme.DigitBrush, Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</UserControl>
