<UserControl
    x:Class="DuolingoWidget.Controls.WideTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DuolingoWidget.Controls"
    Width="310"
    Height="150">
    <Grid>
        <Image Source="{x:Bind Theme.WideBackgroundImage, Mode=OneWay}" Stretch="Fill"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="173"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="123"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Width="173" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <Image x:Name="FireImage" Width="56" Height="56" Stretch="Fill"/>
                    <controls:DigitText Streak="{x:Bind Streak, Mode=OneWay}"
                                        Width="94" Height="38"
                                        OutlineWidth="102" OutlineHeight="46"
                                        MaxTextWidth="94" BaseFontSize="56"
                                        DigitBrush="{x:Bind Theme.DigitBrush, Mode=OneWay}"
                                        OutlineBrush="{x:Bind Theme.DigitOutlineBrush, Mode=OneWay}"
                                        OutlineVisibility="{x:Bind Theme.DigitOutlineVisibility, Mode=OneWay}"/>
                </StackPanel>
                <TextBlock Text="Time to practice!" Visibility="{x:Bind Theme.PhraseVisibility, Mode=OneWay}"
                           FontFamily="ms-appx:///Assets/Fonts/DIN_Next_Rounded_LT_Pro.ttc#DIN Next Rounded LT Pro"
                           FontSize="24" LineHeight="24" TextLineBounds="TrimToCapHeight" FontWeight="Normal"
                           Width="173" Height="24" HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{x:Bind Theme.DigitBrush, Mode=OneWay}"/>
            </StackPanel>
            <Image Grid.Column="2" Source="{x:Bind Theme.WideDuoImage, Mode=OneWay}"
                   Width="123" Height="69" HorizontalAlignment="Right" VerticalAlignment="Center" Stretch="Fill"/>
        </Grid>
    </Grid>
</UserControl>
