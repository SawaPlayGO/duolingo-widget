<UserControl
    x:Class="DuolingoWidget.Controls.SmallFireTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="71"
    Height="71">
    <Grid>
        <Image Source="{x:Bind Theme.SmallBackgroundImage, Mode=OneWay}" Stretch="Fill"/>
        <Image x:Name="FireImage"
               Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill"/>
    </Grid>
</UserControl>
